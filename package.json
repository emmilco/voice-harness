{
  "name": "voice-harness",
  "private": true,
  "workspaces": [
    "core",
    "extension"
  ],
  "scripts": {
    "build": "npm run build -w extension && swift build -c release --package-path voice",
    "check": "tsc -p core --noEmit && tsc -p extension --noEmit",
    "smoke": "npm run smoke -w core",
    "unit": "npm run unit -w core"
  }
}
